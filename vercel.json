{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/:site([a-z0-9][a-z0-9-]*)/:path((?!assets/|icons/|backup/|login\\.html|manifest\\.webmanifest|sw\\.js|robots\\.txt|seal\\.svg).*)",
      "destination": "/:site/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/login",
      "schedule": "17 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, noimageindex, noai, noimageai"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/demo/",
      "permanent": false
    },
    {
      "source": "/:site([a-z0-9][a-z0-9-]*)",
      "destination": "/:site/",
      "permanent": false
    }
  ]
}
