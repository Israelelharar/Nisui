{
  "name": "couple-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "check:leaks": "node scripts/check-leaks.mjs",
    "check:clients": "for c in $(ls clients | grep -v '^_template$'); do echo \"== $c\"; CLIENT=$c npx vite build --logLevel error --outDir dist-check/$c || exit 1; done && rm -rf dist-check"
  },
  "dependencies": {
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/playpen-sans-hebrew": "^5.3.0",
    "@fontsource/secular-one": "^5.3.0",
    "@fontsource/suez-one": "^5.3.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
