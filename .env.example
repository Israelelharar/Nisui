# Set these in Vercel → Project → Settings → Environment Variables. Never commit real values.

# Which couple this deployment is: the folder name in clients/ (e.g. noa-yoav)
CLIENT=demo

# Long random string (at least 24 chars). Signs the login cookie.
SESSION_SECRET=
# Passwords (case and spaces are ignored). ADMIN = the buyer, who also gets /admin.
ADMIN_PASSWORD=
PARTNER_PASSWORD=

# Upstash Redis (set automatically by Vercel's Upstash integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Only when several clients share one database: a unique prefix per client, e.g. noa:
KV_PREFIX=

# Optional: the couple's time zone (default Asia/Jerusalem)
SITE_TZ=

# Notifications to the admin when the partner does something meaningful. Any combination works.
# WhatsApp via CallMeBot: send "I allow callmebot to send me messages" to +34 644 71 81 99, you get an apikey.
NOTIFY_WHATSAPP=
CALLMEBOT_APIKEY=
# E-mail via Resend (resend.com, free): the address you signed up with
NOTIFY_EMAIL=
RESEND_API_KEY=
# Sender name in the e-mail (default "העולם שלנו")
NOTIFY_FROM_NAME=
# Push notifications via the ntfy app (ntfy.sh): pick a long secret topic name and subscribe to it in the app
NTFY_TOPIC=

# Optional: Vercel sends it to the daily keep-alive cron (/api/login GET)
CRON_SECRET=
