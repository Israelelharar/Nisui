# One Vercel project serves every couple (each at /<slug>/). Set these once, in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Long random string (at least 24 chars). Signs the login cookies and makes each site's
# private notification channel. Never change it after launch (everyone would be logged out).
SESSION_SECRET=

# Upstash Redis (set automatically by Vercel's Upstash integration). One database for all sites;
# each site's keys live under "<slug>:".
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: Vercel sends it to the daily keep-alive cron (/api/login GET)
CRON_SECRET=
